{
  "name": "fuddo-ai",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --conditions=react-server --test tests/unit/*.test.ts",
    "test:db": "tsx --env-file=.env.docker --test tests/integration/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "tsx --env-file=.env.docker --test --test-concurrency=1 tests/e2e/*.test.ts",
    "admin:grant": "node --env-file-if-exists=.env scripts/make-admin.mjs",
    "golden:update": "tsx --conditions=react-server scripts/update-golden.mts",
    "textures:refresh": "tsx --conditions=react-server --env-file-if-exists=.env scripts/refresh-textures.mts",
    "textures:seed": "tsx --conditions=react-server --env-file-if-exists=.env scripts/seed-textures.mts",
    "import:legacy": "node --env-file-if-exists=.env scripts/import-legacy.mjs",
    "db:start": "supabase start -x realtime,imgproxy,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.117.2",
    "@types/three": "^0.186.0",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
