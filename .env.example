# --- Supabase (required) -----------------------------------------------------
# Hosted: Project Settings → API. Local: `npx supabase start` prints these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Enables the admin dashboard, the shared rate limiter and paid-image storage. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Providers ----------------------------------------------------------------
# mock draws platings locally for free. gpt-image needs OPENAI_API_KEY.
IMAGE_PROVIDER=mock
MODEL_PROVIDER=mock-3d
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# QUALITY_SPREAD=low
# QUALITY_REFINE=low
# QUALITY_FINAL=high

# --- Safety -------------------------------------------------------------------
# Paid images each chef may generate per hour.
GENERATION_LIMIT_PER_HOUR=120
# Set to 1 only behind a proxy you control that overwrites X-Forwarded-For (automatic on Vercel).
# TRUST_PROXY=1

# --- Ingredient textures ---------------------------------------------------------
# Photographic surfaces wrapped onto the 3D food. auto = Gemini when GEMINI_API_KEY is set, a free local stand-in
# otherwise. A free Gemini key has small per-minute and per-day limits; textures are made once and shared.
# TEXTURE_PROVIDER=auto
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# TEXTURES_PER_MINUTE=6
# TEXTURES_PER_USER_HOUR=40
# POLISH_PER_HOUR=12
